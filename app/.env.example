# Copy this to .env and fill in real values. Never commit .env itself.

# --- Database (matches docker-compose.yml at the repo root) ---
DATABASE_URL="postgresql://app:app@localhost:5432/shooting_club_booking_dev"
# Used only by integration tests (see docker-compose.yml's db_test service).
TEST_DATABASE_URL="postgresql://app:app@localhost:5433/shooting_club_booking_test"

# --- Auth (NextAuth / Auth.js — see specs/01-accounts-and-ranges.md) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Email (Resend — see specs/02-email-notifications.md) ---
RESEND_API_KEY=""
EMAIL_FROM="noreply@harbourhouse.ie"

# --- Bootstrap (see specs/01-accounts-and-ranges.md, "Super Admin") ---
# The one account promoted to Super Admin on first run. Not created via the
# normal registration/invite flow — read once by the seed script.
SUPER_ADMIN_EMAIL=""

# --- Internal endpoints (see specs/04-slots-booking-and-blackouts.md, "Reminders") ---
# Shared secret for POST /api/internal/send-due-reminders, called by an
# OS-level cron entry — never a user-facing auth path. Generate with:
# openssl rand -hex 32
CRON_SECRET=""
